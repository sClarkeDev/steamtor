{
  "name": "steamtor",
  "displayName": "SteamTOR",
  "version": "0.0.4",
  "description": "Simple gaming browser extension",
  "author": "sClarkeDev",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "lint:report": "eslint --output-file eslint_report.json --format json src",
    "postinstall": "wxt prepare",
    "dev:wsl": "bash scripts/dev-wsl.sh"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "@wxt-dev/storage": "^1.2.9",
    "linkedom": "^0.18.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
